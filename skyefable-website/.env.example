# Copy this file to ".env" and fill it in. Never commit ".env".

# Required. Generate a value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-secret

# Shop owner login for the /admin page. The account is created on first start.
# Username: 3-30 letters, numbers or underscores. Password: 10-128 characters.
# Leave both blank and no admin account will be created.
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=change-this-password

# Set to 1 once the site is served over HTTPS.
# COOKIE_SECURE=1

# Optional: transactional emails on order status changes, via Resend
# (https://resend.com). Leave RESEND_API_KEY unset to disable emails
# entirely -- checkout and status updates work the same either way.
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=Skye Crafts <hello@mailer.yourdomain.com>
# EMAIL_ENABLED=false
